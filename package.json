{
  "name": "ble-provisioning",
  "version": "1.0.0",
  "private": true,
  "description": "BLE蓝牙配网微信小程序 docs/device-integration.md",
  "scripts": {
    "dev:mp-weixin": "cross-env CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=1000 UNI_OUTPUT_DIR=dist/mp-weixin uni -p mp-weixin",
    "build:mp-weixin": "cross-env CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=1000 UNI_OUTPUT_DIR=dist/mp-weixin uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "test": "node test/run.js",
    "build:regions": "node scripts/build-regions.js",
    "verify": "npm run type-check && npm run test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.5.1",
    "cross-env": "^10.1.0",
    "typescript": "^5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "uniapp",
    "vue3",
    "typescript",
    "ble",
    "wifi-provisioning",
    "device-provisioning"
  ],
  "license": "UNLICENSED"
}
